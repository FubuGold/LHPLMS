{
    "name": "backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "format": "prettier --write \"**/*.js\"",
        "start": "babel-node index.js",
        "gateway": "cd ./apps/api-gateway && babel-node index.js",
        "auth": "cd ./apps/auth && babel-node index.js",
        "user": "cd ./apps/user && babel-node index.js",
        "post": "cd ./apps/post && babel-node index.js",
        "assignment": "cd ./apps/assignment && babel-node index.js",
        "class": "cd ./apps/class && babel-node index.js",
        "question-bank": "cd ./apps/question-bank && babel-node index.js",
        "gateway:dev": "cd ./apps/api-gateway && nodemon",
        "auth:dev": "cd ./apps/auth && nodemon",
        "user:dev": "cd ./apps/user && nodemon",
        "post:dev": "cd ./apps/post && nodemon",
        "assignment:dev": "cd ./apps/assignment && nodemon",
        "submission:dev": "cd ./apps/submission && nodemon",
        "class:dev": "cd ./apps/class && nodemon",
        "question-bank:dev": "cd ./apps/question-bank && nodemon",
        "start:dev": "concurrently \"npm run gateway:dev\" \"npm run user:dev\" \"npm run auth:dev\" \"npm run post:dev\" \"npm run assignment:dev\" \"npm run class:dev\"",
        "test": "jest --watch",
        "test:cov": "jest --coverage",
        "test:e2e": "jest --config ./apps/backend/test/jest-e2e.json",
        "prepare:dev": "husky install"
    },
    "dependencies": {
        "@apollo/server": "^4.11.3",
        "@nestjs/apollo": "^13.0.3",
        "@nestjs/axios": "^4.0.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.1",
        "@nestjs/core": "^11.0.1",
        "@nestjs/event-emitter": "^3.0.0",
        "@nestjs/graphql": "^13.0.3",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/microservices": "^11.0.10",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "^11.0.6",
        "@prisma/client": "^6.4.1",
        "babel-plugin-transform-decorators-legacy": "^1.3.5",
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.7",
        "graphql": "^16.10.0",
        "nestjs-spelunker": "^1.3.2",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.2.0"
    },
    "devDependencies": {
        "@babel/core": "7.26.0",
        "@babel/node": "7.26.0",
        "@babel/plugin-proposal-decorators": "7.25.9",
        "@babel/plugin-transform-runtime": "7.25.9",
        "@babel/preset-env": "7.26.9",
        "@babel/register": "7.25.9",
        "@babel/runtime": "^7.26.10",
        "@commitlint/cli": "^19.7.1",
        "@commitlint/config-conventional": "^19.7.1",
        "@nestjs/cli": "^11.0.5",
        "@nestjs/testing": "^11.0.1",
        "babel-plugin-module-resolver": "^5.0.2",
        "concurrently": "^9.1.2",
        "husky": "^8.0.0",
        "jest": "29.7.0",
        "nodemon": "3.1.9",
        "prettier": "3.4.2",
        "prisma": "^6.4.1",
        "supertest": "7.0.0",
        "testcontainers": "^10.22.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json"
        ],
        "rootDir": ".",
        "testRegex": ".spec.js$",
        "coverageDirectory": "./coverage",
        "roots": [
            "<rootDir>/apps/",
            "<rootDir>/libs/"
        ],
        "moduleNameMapper": {
            "^@app/config(|/.*)$": "<rootDir>/libs/config/src/$1",
            "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1"
        }
    }
}
