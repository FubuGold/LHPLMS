// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @db.Text
  UserGroup UserGroup[]
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.Text
  username       String           @unique @db.Text
  dob            DateTime         @db.Date
  avatar         String?          @db.Text
  quote          String?          @db.Text
  gender         Boolean?         @db.Boolean
  phoneNumber    String?          @unique @db.Text
  email          String?          @unique @db.Text
  roleId         String?          @db.Uuid
  UserTask       UserTask[]
  UserGroup      UserGroup[]
  UserClass      UserClass[]
  UserToken      UserToken[]
  UserCredential UserCredential[]
  UserSetting    UserSetting[]

  class           Class[]
  classPost       ClassPost[]
  classAssignemnt ClassAssignment[]
  questionBank    QuestionBank[]
  submission      Submission[]
  role            Role?             @relation(fields: [roleId], references: [id])
}

model UserToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  token  String @unique @db.Text
  user   User   @relation(fields: [userId], references: [id])
}

model UserCredential {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  password String @db.Text
  salt     String @db.Text
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model UserSetting {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @db.Uuid
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name        String  @db.Text
  description String? @db.Text
  property    Json    @db.Json
}

model UserTask {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  assignmentId String          @db.Uuid
  isDone       Boolean         @db.Boolean
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignment   ClassAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([assignmentId])
}

model UserGroup {
  userId  String @db.Uuid
  groupId String @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, groupId])
}

model UserClass {
  userId  String @db.Uuid
  classId String @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, classId])
}

model Submission {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @db.Uuid
  score        Float    @db.DoublePrecision
  ownerId      String   @db.Uuid
  createAt     DateTime @default(now()) @db.Timestamptz

  owner            User               @relation(fields: [ownerId], references: [id])
  submissionAnswer SubmissionAnswer[]
}

model SubmissionAnswer {
  id           String @id @default(uuid()) @db.Uuid
  submissionId String @db.Uuid
  questionId   String @db.Uuid
  answers      Int[]

  submission Submission              @relation(fields: [submissionId], references: [id])
  question   ClassAssignmentQuestion @relation(fields: [questionId], references: [id])
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.Text
  User User[]
}

model Subject {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.Text
  QuestionBank QuestionBank[]
  Class        Class[]
}

model Class {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.Text
  subjectId       String   @db.Uuid
  ownerId         String   @db.Uuid
  createAt        DateTime @default(now()) @db.Timestamptz
  backgroundImage String?  @db.Text

  subject         Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ClassPost       ClassPost[]
  ClassAssignment ClassAssignment[]
  UserClass       UserClass[]
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model ClassPost {
  id       String   @id @default(uuid()) @db.Uuid
  classId  String   @db.Uuid
  title    String   @db.Text
  content  String   @db.Text
  ownerId  String   @db.Uuid
  createAt DateTime @default(now()) @db.Timestamptz

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([classId])
}

model ClassAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  classId   String    @db.Uuid
  name      String    @db.Text
  startTime DateTime  @db.Timestamptz
  endTime   DateTime? @db.Timestamptz
  isTest    Boolean   @db.Boolean
  ownerId   String    @db.Uuid
  createAt  DateTime  @default(now()) @db.Timestamptz

  class                   Class                     @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ClassAssignmentQuestion ClassAssignmentQuestion[]
  UserTask                UserTask[]
  owner                   User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model ClassAssignmentQuestion {
  id                       String   @id @default(uuid()) @db.Uuid
  assignmentId             String   @db.Uuid
  statement                String   @db.Text
  assignmentQuestionChoice String[]
  origin                   String   @db.Uuid

  assignment       ClassAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  question         Question           @relation(fields: [origin], references: [id])
  SubmissionAnswer SubmissionAnswer[]

  @@index([assignmentId])
}

model QuestionBank {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @db.Uuid
  name      String   @db.Text
  ownerId   String   @db.Uuid
  createAt  DateTime @default(now()) @db.Timestamptz

  subject  Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Question Question[]
  owner    User       @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([subjectId])
}

model Question {
  id             String   @id @default(uuid()) @db.Uuid
  statement      String   @db.Text
  questionBankId String   @db.Uuid
  questionChoice String[]
  correctAnswer  Int[]

  questionBank       QuestionBank              @relation(fields: [questionBankId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignmentQuestion ClassAssignmentQuestion[]

  @@index([questionBankId])
}
