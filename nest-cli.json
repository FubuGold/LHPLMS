{
  "$schema": "https://json.schemastore.org/nest-cli",
  "language": "js",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "monorepo": true,
  "root": "apps/api-gateway",
  "compilerOptions": {
    "builder": "webpack",
    "tsConfigPath": "apps/api-gateway/jsconfig.json",
    "webpack": true
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "builder": "webpack",
        "tsConfigPath": "apps/api-gateway/jsconfig.json"
      }
    },
    "assignment": {
      "type": "application",
      "root": "apps/assignment",
      "entryFile": "main",
      "sourceRoot": "apps/assignment/src",
      "compilerOptions": {
        "tsConfigPath": "apps/assignment/jsconfig.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "builder": "webpack",
        "tsConfigPath": "apps/auth/jsconfig.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "group": {
      "type": "application",
      "root": "apps/group",
      "entryFile": "main",
      "sourceRoot": "apps/group/src",
      "compilerOptions": {
        "tsConfigPath": "apps/group/jsconfig.json"
      }
    },
    "post": {
      "type": "application",
      "root": "apps/post",
      "entryFile": "main",
      "sourceRoot": "apps/post/src",
      "compilerOptions": {
        "tsConfigPath": "apps/post/jsconfig.json"
      }
    },
    "question-bank": {
      "type": "application",
      "root": "apps/question-bank",
      "entryFile": "main",
      "sourceRoot": "apps/question-bank/src",
      "compilerOptions": {
        "tsConfigPath": "apps/question-bank/jsconfig.json"
      }
    },
    "subject": {
      "type": "application",
      "root": "apps/subject",
      "entryFile": "main",
      "sourceRoot": "apps/subject/src",
      "compilerOptions": {
        "tsConfigPath": "apps/subject/jsconfig.json"
      }
    },
    "submission": {
      "type": "application",
      "root": "apps/submission",
      "entryFile": "main",
      "sourceRoot": "apps/submission/src",
      "compilerOptions": {
        "tsConfigPath": "apps/submission/jsconfig.json"
      }
    },
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "builder": "webpack",
        "tsConfigPath": "apps/user/jsconfig.json"
      }
    }
  }
}